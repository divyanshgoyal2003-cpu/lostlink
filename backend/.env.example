# Backend-only values. Never place these in frontend/.env or any VITE_* variable.
NODE_ENV=development
PORT=5000

# Configure DATABASE_URL, or use all five DB_* values. Production TLS validates certificates.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# If not using DATABASE_URL, configure all of these instead:
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=
DB_POOL_MAX=3
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

# Generate distinct secrets locally. At least 32 random bytes each.
JWT_SECRET=
CUSTODY_CODE_HMAC_KEY=
CUSTODY_CODE_TTL_MINUTES=30

# Exact comma-separated HTTPS origins in production; localhost:5173 is allowed in development.
ALLOWED_ORIGINS=http://localhost:5173

# Vercel Blob must be a PRIVATE store. Connected Vercel projects provide these values.
PRIVATE_STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
# Configure unique environment and scope values when using private Blob storage.
PRIVATE_STORAGE_ENVIRONMENT=
PRIVATE_STORAGE_SCOPE_ID=
# Required only by the orphan-prune utility; must exactly match current_database().
PRUNE_EXPECTED_DATABASE_NAME=
PRIVATE_PHOTO_DIR=./private-photos
PRIVATE_PROOF_DIR=./private-proof-files
CHAT_PROOF_MAX_BYTES=8388608
